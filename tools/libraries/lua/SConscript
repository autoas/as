from building import *

CWD = GetCurrentDir()

objs = Glob("aslua_can.cpp") + Glob("aslua.cpp")
objsAsn1x509 = Glob("aslua_x509.cpp")
objsCrypto = Glob("aslua_crypto.cpp")


def GetLuaPackage():
    cmd = 'sed -i "612c extern void luaL_openAsBuiltlibs(lua_State *L);" lua.c'
    cmd += ' && sed -i "634c luaL_openlibs(L); luaL_openAsBuiltlibs(L);" lua.c'
    pkg = Package("https://gitee.com/mirrors/lua.git", version="v5.4.6", cmd=cmd)
    return pkg


@register_library
class LibraryLUA(Library):
    def config(self):
        pkg = GetLuaPackage()
        self.include = ["%s/include" % (CWD), pkg]
        self.CPPPATH = ["$INFRAS"]
        self.LIBS = ["Utils", "CanL"]
        luaObjs = PkgGlob(pkg, ["*.c"])
        SrcRemove(luaObjs, ["lua.c", "onelua.c"])
        self.source = objs + luaObjs
        if IsBuildForMSVC():
            pass
        else:
            # The crypto and x509 bindings are ON by default: a LUA library built
            # without them still links, but every script that calls
            # require("crypto") / require("x509") fails at run time
            # (lua_pcall -> LUA_ERRRUN, "create lua state failed: error = 2").
            # Opt out explicitly with LUA_WITH_CRYPTO=NO / LUA_WITH_ASN1X509=NO.
            if os.getenv("LUA_WITH_ASN1X509", "YES") != "NO":
                self.LIBS += ["ASN1X509"]
                self.CPPDEFINES += ["USE_ASN1X509"]
                self.source += objsAsn1x509
            else:
                print("LUA: x509 bindings disabled (LUA_WITH_ASN1X509=NO)")
            if os.getenv("LUA_WITH_CRYPTO", "YES") != "NO":
                self.LIBS += ["CryptoIf"]
                self.CPPDEFINES += ["USE_CRYPTOIF"]
                self.source += objsCrypto
            else:
                print("LUA: crypto bindings disabled (LUA_WITH_CRYPTO=NO)")


@register_application
class ApplicationLua(Application):
    def config(self):
        pkg = GetLuaPackage()
        self.include = ["%s/include" % (CWD)]
        self.CPPPATH = [pkg, "$INFRAS"]
        self.LIBS += ["LUA"]
        luaMain = PkgGlob(pkg, ["lua.c"])
        self.source = luaMain
        self.Install("../one")
