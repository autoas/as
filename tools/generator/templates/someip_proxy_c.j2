    if (false == msg->MoreSegmentsFlag) {
      msg->Data = (uint8_t *)s_{{ field['Name'] }}Payload;
    }
  } else {
    ret = E_NOT_OK;
  }
  return ret;
}
{% endif %}
{% endif %}
{% endfor %}

