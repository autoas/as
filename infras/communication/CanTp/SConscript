from building import *

CWD = GetCurrentDir()
objs = Glob("*.c")


@register_library
class LibraryCanTp(Library):
    def config(self):
        # $Dcm_Cfg is needed by the generated CanTp_Cfg.c when
        # PDUR_DCM_CANTP_ZERO_COST is defined
        self.CPPPATH = ["$INFRAS", "$CanIf_Cfg", "$PduR_Cfg", "$Dcm_Cfg", CWD]
        self.source = objs
